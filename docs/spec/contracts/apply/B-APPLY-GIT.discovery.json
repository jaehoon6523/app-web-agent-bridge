// B-APPLY-GIT 2차 discovery setups
// 목적: GitChangeWorkspace의 실제 메서드 시그니처를 실행으로 캡처
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { execFileSync } from "node:child_process";

function makeTargetRepo() {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "b-apply-git-"));
  execFileSync("git", ["init", "-q"], { cwd: dir });
  execFileSync("git", ["config", "user.email", "test@example.com"], { cwd: dir });
  execFileSync("git", ["config", "user.name", "test"], { cwd: dir });
  fs.writeFileSync(path.join(dir, "README.md"), "# target\n");
  execFileSync("git", ["add", "."], { cwd: dir });
  execFileSync("git", ["commit", "-q", "-m", "init"], { cwd: dir });
  const baseCommit = execFileSync("git", ["rev-parse", "HEAD"], { cwd: dir })
    .toString().trim();
  return { dir, baseCommit };
}

async function loadModule() {
  try {
    return await import("file:///" + process.cwd().replace(/\\/g, "/") + "/src/repository/git-change-workspace.js");
  } catch (err) {
    return { __loadError: err.message };
  }
}

// 목적: API shape 캡처. 실제 호출 없이 무엇이 있는지 관찰.
async function inspect() {
  const mod = await loadModule();
  if (mod.__loadError) {
    return {
      threw: false,
      discovery: "MODULE_LOAD_FAILED",
      loadError: mod.__loadError,
    };
  }
  const GCW = mod.GitChangeWorkspace;
  if (!GCW) {
    return {
      threw: false,
      discovery: "CLASS_NOT_EXPORTED",
      moduleExports: Object.keys(mod),
    };
  }
  const staticMethods = Object.getOwnPropertyNames(GCW)
    .filter(n => typeof GCW[n] === "function" && n !== "length" && n !== "name" && n !== "prototype");
  const instanceMethods = Object.getOwnPropertyNames(GCW.prototype)
    .filter(n => typeof GCW.prototype[n] === "function" && n !== "constructor");
  return {
    threw: false,
    discovery: "API_SHAPE_CAPTURED",
    staticMethods,
    instanceMethods,
    staticMethodSignatures: staticMethods.map(n => ({ name: n, length: GCW[n].length })),
  };
}

export const setups = {
  "GIT-APPLY-NORMAL": async (t) => {
    const shape = await inspect();
    return { observed: shape };
  },
  "GIT-APPLY-BASE-DRIFT": async (t) => {
    const shape = await inspect();
    return { observed: { ...shape, case: "BASE-DRIFT: " + JSON.stringify(shape) } };
  },
  "GIT-APPLY-DIRTY-TARGET": async (t) => {
    const shape = await inspect();
    return { observed: { ...shape, case: "DIRTY-TARGET" } };
  },
  "GIT-STATE-APPLIED": async (t) => {
    const shape = await inspect();
    return { observed: { ...shape, case: "STATE-APPLIED" } };
  },
  "GIT-STATE-NOT-APPLIED": async (t) => {
    const shape = await inspect();
    return { observed: { ...shape, case: "STATE-NOT-APPLIED" } };
  },
  "GIT-STATE-AMBIGUOUS": async (t) => {
    const shape = await inspect();
    return { observed: { ...shape, case: "STATE-AMBIGUOUS" } };
  },
};