{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "boundaryId",
    "boundaryRevision",
    "evidenceType",
    "transitions"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "boundaryId": {
      "type": "string",
      "minLength": 1
    },
    "boundaryRevision": {
      "type": "integer",
      "minimum": 1
    },
    "evidenceType": {
      "const": "partial-integration"
    },
    "entryPoint": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "ACTIVE"
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "transitionId",
          "expected"
        ],
        "properties": {
          "transitionId": {
            "type": "string",
            "minLength": 1
          },
          "setupId": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "throws"
            ],
            "properties": {
              "throws": {
                "type": "boolean"
              },
              "errorCode": {
                "type": "string",
                "minLength": 1
              },
              "errorMessage": {
                "type": "string",
                "minLength": 1
              },
              "stageAfter": {
                "type": "string",
                "pattern": "^[A-Z_]+$|^unchanged$"
              },
              "applicationAfter": {
                "oneOf": [
                  {
                    "enum": [
                      "absent",
                      "unchanged"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "minProperties": 1,
                    "properties": {
                      "status": {
                        "type": "string",
                        "minLength": 1
                      },
                      "hasFields": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "retiredTransitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "transitionId",
          "reason"
        ],
        "properties": {
          "transitionId": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
