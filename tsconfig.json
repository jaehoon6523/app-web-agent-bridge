{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedSideEffectImports": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.js",
    "scripts/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "public",
    "extension",
    "tests"
  ]
}
