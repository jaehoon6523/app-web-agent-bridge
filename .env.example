# The controller can boot with no .env file. Values below either have defaults
# or enable a specific integration. Explicitly supplied invalid values fail fast.

# Core local server settings. Remote bind addresses are intentionally rejected.
HOST=127.0.0.1
PORT=8787
WORKSPACE=.
CONTROLLER_DATA_DIR=.agent-controller
DEMO_MODE=false

# Optional Chrome Extension integration. Configure BOTH values to enable live
# Web turns. Leaving both blank disables only the Web integration.
WEB_EXTENSION_SHARED_SECRET=
WEB_EXTENSION_EXPECTED_IDENTITY=

# Optional stable token for explicit local API/automation clients.
# The same-origin browser dashboard receives its own process-lifetime token and
# does not require this value.
DASHBOARD_TOKEN=

# Optional existing project JSON. Dashboard-saved settings take precedence.
AUDIT_PROJECT_FILE=

# Optional Codex integration. Leaving CODEX_EXECUTABLE blank keeps live Codex
# composition disabled without preventing server startup.
CODEX_EXECUTABLE=
CODEX_HOME=

# Implementation worker. codex is the default. Non-Codex providers require a
# JSONL-compatible executable before a code-change run can start.
CODE_WORKER_PROVIDER=codex
CODE_WORKER_MODEL=
CODE_WORKER_EXECUTABLE=
CODE_WORKER_ARGS=[]

# Active Web-turn timeout. Must be at least 10000 ms when explicitly set.
WEB_RESPONSE_TIMEOUT_MS=300000

# Tooling-only overrides. They are not controller startup requirements.
BRIDGE_BASE_URL=
CERTIFY_RUN_ID=
CERTIFY_EXPECT_APPLIED=false
UI_BROWSER_CHANNEL=chrome
UI_BROWSER_EXECUTABLE=

# Reserved runtime variables BRIDGE_RESULT_DIR and BRIDGE_EXECUTION_ID are
# injected into verification processes by the controller; do not configure them
# as persistent operator settings.
#
# EXTENSION_TOKEN is legacy and intentionally ignored. It is not an authentication
# fallback for WEB_EXTENSION_SHARED_SECRET.
