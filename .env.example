# Controller HTTP/WebSocket server. Keep it loopback-only unless you add real authentication.
HOST=127.0.0.1
PORT=8787

# HMAC authentication for the Chrome extension. The shared secret must match the
# value stored by the extension. Copy the extension identity shown in its popup
# after saving the secret; the Controller accepts only that persisted identity.
WEB_EXTENSION_SHARED_SECRET=
WEB_EXTENSION_EXPECTED_IDENTITY=

# Separate base64url local command token for POST /api/runs/start. It must not
# reuse the Extension shared secret and must contain at least 32 UTF-8 bytes.
DASHBOARD_TOKEN=

# Workspace supplied to the read-only Codex app-server session.
WORKSPACE=.

# JSON file containing projectId, absolute targetRoot, requirements, policy and
# registered verifications. Missing/invalid settings block implementation runs.
AUDIT_PROJECT_FILE=

# Live composition pins this exact executable before starting app-server. On
# Windows use the real codex.exe, never a .cmd/.bat shim. Leaving this blank
# keeps the live composition factory unavailable and does not start Codex.
CODEX_EXECUTABLE=

# Optional location for controller.sqlite and redacted runtime artifacts.
# It is resolved under WORKSPACE.
CONTROLLER_DATA_DIR=.agent-controller

# Extension response timeout used by the currently active Web adapter.
WEB_RESPONSE_TIMEOUT_MS=300000

# Start without extension authentication for a server/static-UI smoke check.
# Live commands remain disabled in demo mode; demo mode does not simulate
# successful Agent sessions.
DEMO_MODE=false
